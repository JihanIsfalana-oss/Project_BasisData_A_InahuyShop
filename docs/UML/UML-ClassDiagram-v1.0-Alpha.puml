@startuml UML-ClassDiagram-v1.0-Alpha
' InahuyShop — UML Class Diagram v1.0-Alpha
' Initial domain model. Validate all assumptions against the PRD and ERD.

left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members

title InahuyShop — UML Class Diagram v1.0-Alpha

package "Identity & Access" {
  class User {
    +UUID id
    +String fullName
    +String email
    -String passwordHash
    +UserStatus status
    +DateTime createdAt
    +DateTime updatedAt
    +hasRole(roleCode: String) boolean
  }

  class Role {
    +UUID id
    +String code
    +String name
    +String description
    +boolean isSystemRole
  }

  enum UserStatus {
    ACTIVE
    SUSPENDED
    DEACTIVATED
  }
}

package "Product Catalogue" {
  class Product {
    +UUID id
    +String name
    +String slug
    +String description
    +Decimal priceAmount
    +String currency
    +ProductStatus status
    +DateTime? publishedAt
    +DateTime createdAt
    +DateTime updatedAt
    +publish() void
    +archive() void
  }

  class Category {
    +UUID id
    +String name
    +String slug
    +String description
  }

  class ProductMedia {
    +UUID id
    +String storageKey
    +String mediaType
    +String altText
    +int sortOrder
  }

  class DigitalAsset {
    +UUID id
    +String storageKey
    +String fileName
    +String mimeType
    +long sizeBytes
    +String version
    +boolean isActive
  }

  enum ProductStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
}

package "Cart" {
  class Cart {
    +UUID id
    +CartStatus status
    +DateTime createdAt
    +DateTime updatedAt
    +addItem(product: Product, quantity: int) void
    +removeItem(productId: UUID) void
    +clear() void
  }

  class CartItem {
    +UUID id
    +int quantity
    +DateTime createdAt
    +changeQuantity(quantity: int) void
  }

  enum CartStatus {
    ACTIVE
    CHECKED_OUT
    ABANDONED
  }
}

package "Order & Payment" {
  class Order {
    +UUID id
    +String orderNumber
    +OrderStatus status
    +Decimal totalAmount
    +String currency
    +DateTime placedAt
    +DateTime? paidAt
    +DateTime createdAt
    +calculateTotal() Decimal
    +markPaid() void
    +cancel() void
  }

  class OrderItem {
    +UUID id
    +String productNameSnapshot
    +Decimal unitPriceSnapshot
    +int quantity
    +Decimal lineTotalSnapshot
    +calculateLineTotal() Decimal
  }

  class Payment {
    +UUID id
    +String provider
    +String? providerReference
    +Decimal amount
    +String currency
    +PaymentStatus status
    +DateTime createdAt
    +DateTime updatedAt
    +DateTime? succeededAt
  }

  enum OrderStatus {
    PENDING_PAYMENT
    PAID
    COMPLETED
    CANCELLED
    REFUNDED
  }

  enum PaymentStatus {
    PENDING
    SUCCEEDED
    FAILED
    CANCELLED
    EXPIRED
    REFUNDED
  }
}

package "Digital Delivery" {
  class DownloadEntitlement {
    +UUID id
    +EntitlementStatus status
    +DateTime grantedAt
    +DateTime? expiresAt
    +int downloadCount
    +int? maxDownloads
    +canDownload(at: DateTime) boolean
    +recordDownload() void
  }

  enum EntitlementStatus {
    ACTIVE
    REVOKED
    EXPIRED
  }
}

' Relationships and multiplicities
User "0..*" -- "0..*" Role : assigned roles
User "1" --> "0..*" Cart : owns
Cart "1" *-- "0..*" CartItem : contains
CartItem "0..*" --> "1" Product : selects

User "1" --> "0..*" Order : places
Order "1" *-- "0..*" OrderItem : contains
OrderItem "0..*" --> "1" Product : purchased product
Order "1" --> "0..*" Payment : payment attempts

Category "0..1" <-- "0..*" Product : classified as
Product "1" *-- "0..*" ProductMedia : public presentation media
Product "1" *-- "0..*" DigitalAsset : protected deliverables
OrderItem "1" --> "0..*" DownloadEntitlement : grants after payment

note bottom
  Version: v1.0-Alpha
  Status: Initial draft; not yet reconciled against the authoritative ERD.
  Validate assumptions and cardinalities against PRD, Architecture, and ERD.
end note

@enduml
