{
  "name": "inahuyshop",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:storefront": "pnpm --filter storefront-web dev",
    "dev:admin-web": "pnpm --filter admin-web dev",
    "dev:customer-mobile": "pnpm --filter customer-mobile start",
    "dev:admin-mobile": "pnpm --filter admin-mobile start",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "pnpm -r --workspace-concurrency=1 --if-present run lint",
    "build": "pnpm --filter storefront-web --filter admin-web run build",
    "check:api": "node --check apps/api/src/index.js",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:repo": "node scripts/verify-repo.mjs && git diff --check",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm check:api && pnpm check:boundaries && pnpm check:repo"
  },
  "devDependencies": {
    "@inahuyshop/config-prettier": "workspace:*",
    "prettier": "^3.9.10"
  }
}
